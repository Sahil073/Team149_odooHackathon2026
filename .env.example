# Server Configuration
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# PostgreSQL Connection String
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dealflow360?schema=public"

# Redis Pub/Sub
REDIS_URL="redis://localhost:6379"

# Staff Auth Secrets
JWT_SECRET="super-secret-key-dealflow360-jwt-staff-min32chars"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_SECRET="super-secret-key-dealflow360-refresh-staff-min32chars"
JWT_REFRESH_EXPIRES_IN="7d"

# Customer Portal Auth
PORTAL_JWT_SECRET="super-secret-key-dealflow360-jwt-portal-min32chars"
PORTAL_JWT_EXPIRES_IN="12h"

# Frontend Origin for CORS
CORS_ORIGIN="http://localhost:5173"

# Smart Layer Integration (Team B Gateway on Port 8000)
SMART_LAYER_BASE_URL="http://localhost:8000"
SMART_LAYER_TIMEOUT_MS=3000

