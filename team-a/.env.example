# ==============================================================================
# DealFlow360 - Team A Root Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 2. Database Connection (PostgreSQL)
# ------------------------------------------------------------------------------
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dealflow360?schema=public"

# ------------------------------------------------------------------------------
# 3. Cache & Pub/Sub (Redis)
# ------------------------------------------------------------------------------
# In-memory fallback is active if local Redis is offline
REDIS_URL="redis://localhost:6379"

# ------------------------------------------------------------------------------
# 4. Authentication Secrets (Min 32 characters for security)
# ------------------------------------------------------------------------------
# Staff Auth (Rep, Manager, Finance, Admin)
JWT_SECRET="super-secret-key-dealflow360-jwt-staff-min32chars"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_SECRET="super-secret-key-dealflow360-refresh-staff-min32chars"
JWT_REFRESH_EXPIRES_IN="7d"

# Customer Portal Auth (Dedicated isolated secret to prevent token forgery)
PORTAL_JWT_SECRET="super-secret-key-dealflow360-jwt-portal-min32chars"
PORTAL_JWT_EXPIRES_IN="12h"

# ------------------------------------------------------------------------------
# 5. Frontend & CORS Configuration
# ------------------------------------------------------------------------------
# Allowed origin for Express server CORS
CORS_ORIGIN="http://localhost:3000"

# Vite Frontend API Base URL (consumed by client)
VITE_API_BASE_URL="http://localhost:4000/api"

# ------------------------------------------------------------------------------
# 6. Smart Layer Integration (Team B)
# ------------------------------------------------------------------------------
# Base URL for Team B's AI/ML microservices (Risk engine, upsell, deal health)
SMART_LAYER_BASE_URL="http://localhost:5000/api"
# Fallback timeout in ms (ICD §5: fails safe if Team B is unreachable or times out)
SMART_LAYER_TIMEOUT_MS=2000
