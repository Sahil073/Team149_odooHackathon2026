# Environment Configuration
NODE_ENV=development
PORT=4000

# PostgreSQL Connection String
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dealflow360?schema=public"

# Redis Connection URL
REDIS_URL="redis://localhost:6379"

# Staff Authentication Secrets (Min 32 characters)
JWT_SECRET="super-secret-key-dealflow360-jwt-staff-min32chars"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_SECRET="super-secret-key-dealflow360-refresh-staff-min32chars"
JWT_REFRESH_EXPIRES_IN="7d"

# Customer Portal Authentication Secret (Isolated secret)
PORTAL_JWT_SECRET="super-secret-key-dealflow360-jwt-portal-min32chars"
PORTAL_JWT_EXPIRES_IN="12h"

# Frontend Origin for CORS
CORS_ORIGIN="http://localhost:3000"

# Smart Layer Integration (Team B)
# SMART_LAYER_BASE_URL="http://localhost:5000/api"
SMART_LAYER_TIMEOUT_MS=2000

# Logging
LOG_LEVEL="info"
